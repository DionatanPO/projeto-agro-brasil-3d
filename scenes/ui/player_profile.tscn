[gd_scene format=3 uid="uid://0jvpln1tne0u"]

[ext_resource type="Script" uid="uid://dumsyo1nygi7b" path="res://scripts/ui/player_profile.gd" id="1_dfk3y"]

; Card compacto de perfil do jogador.
; Posicao e tamanho finais sao definidos pelo script (HUD_MARGIN / HUD_SIZE).
[node name="PlayerProfile" type="Control" unique_id=146114355]
script = ExtResource("1_dfk3y")
; Tamanho inicial — o script vai sobrescrever em _ready().
custom_minimum_size = Vector2(300, 80)
size = Vector2(300, 80)
; Ancorado no topo-esquerdo (preset 0 = sem ancora relativa).
anchors_preset = 0
anchor_left = 0.0
anchor_top = 0.0
anchor_right = 0.0
anchor_bottom = 0.0
; Impede que filhos recebam eventos de mouse.
mouse_filter = 2

; ── Fundo com vidro escuro e bordas arredondadas ────────────────────────────
[node name="Fundo" type="Panel" parent="." unique_id=146114356]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

; ── Container principal (horizontal): avatar | info ─────────────────────────
[node name="Layout" type="HBoxContainer" parent="." unique_id=146114360]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 10.0
offset_top = 10.0
offset_right = -10.0
offset_bottom = -10.0
theme_override_constants/separation = 10
mouse_filter = 2

; ── Máscara circular do avatar ──────────────────────────────────────────────
; Um Control quadrado que corta a imagem usando clip_contents.
[node name="AvatarMask" type="Control" parent="Layout" unique_id=146114370]
layout_mode = 2
custom_minimum_size = Vector2(56, 56)
size_flags_vertical = 4
clip_contents = true
mouse_filter = 2

[node name="Avatar" type="TextureRect" parent="Layout/AvatarMask" unique_id=1612149475]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
expand_mode = 1
stretch_mode = 6
mouse_filter = 2

; ── Coluna direita: NivelRow + BarraXP + LabelXP ────────────────────────────
[node name="Info" type="VBoxContainer" parent="Layout" unique_id=146114380]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_constants/separation = 4
mouse_filter = 2

; Linha: "Nível" (rótulo) + número
[node name="NivelRow" type="HBoxContainer" parent="Layout/Info" unique_id=256792814]
layout_mode = 2
theme_override_constants/separation = 6
mouse_filter = 2

[node name="NivelTexto" type="Label" parent="Layout/Info/NivelRow" unique_id=256792815]
layout_mode = 2
text = "NÍVEL"
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.72, 0.80, 0.74, 1)
mouse_filter = 2

[node name="LevelLabel" type="Label" parent="Layout/Info/NivelRow" unique_id=1401400443]
layout_mode = 2
text = "01"
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.42, 1.0, 0.62, 1)
mouse_filter = 2

; Barra de XP (ProgressBar simples — sem textura, para garantir visibilidade)
[node name="XPBar" type="ProgressBar" parent="Layout/Info" unique_id=617275820]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 10)
min_value = 0.0
max_value = 100.0
value = 35.0
show_percentage = false
mouse_filter = 2

; Texto de XP
[node name="XPLabel" type="Label" parent="Layout/Info" unique_id=772812954]
layout_mode = 2
text = "35 / 100 XP"
theme_override_font_sizes/font_size = 10
theme_override_colors/font_color = Color(0.65, 0.72, 0.67, 1)
mouse_filter = 2
